{
  "name": "guilinol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:admin": "node scripts/auth-test.mjs --admin-ui",
    "test:bridge": "node scripts/auth-test.mjs --bridge",
    "dev:full": "npm run build && wrangler d1 migrations apply glol --local && wrangler pages dev dist --binding EMAIL_DEV_LOG=1",
    "test:api": "node --test scripts/test-projection.mjs && node scripts/auth-test.mjs",
    "verify:feedback": "node scripts/auth-test.mjs --feedback-ui",
    "verify:auth": "node scripts/auth-test.mjs --ui",
    "check:api": "tsc -p functions",
    "basis": "node scripts/basis.mjs",
    "predev": "npm run basis",
    "prebuild": "npm run basis",
    "landmarks": "uv run --locked python pipeline/pack_landmarks.py",
    "world": "uv run --locked python pipeline/world.py",
    "audit:grounding": "uv run --locked python pipeline/audit_grounding.py",
    "audit:seams": "uv run --locked python pipeline/audit_seams.py",
    "audit:landmarks": "uv run --locked python pipeline/audit_landmarks.py",
    "audit:grounding:market": "uv run --locked python scripts/dongxi/grounding.py",
    "credits": "node scripts/photo-credits.mjs",
    "og": "node scripts/og.mjs",
    "dev": "vite web --config web/vite.config.ts",
    "build": "node scripts/photo-credits.mjs && tsc -p web && vite build web --config web/vite.config.ts && node scripts/og.mjs",
    "preview": "vite preview web --config web/vite.config.ts",
    "verify:flight": "node scripts/flight.mjs",
    "verify:spawn": "node scripts/spawn-pool.mjs --check",
    "verify:atlas": "node --experimental-strip-types scripts/atlas.mjs",
    "verify:walk": "npm run verify:walk:quick",
    "verify:walk:quick": "node scripts/walk-quick.mjs",
    "verify:walk:full": "node scripts/walk.mjs",
    "verify:ride": "node scripts/ride.mjs",
    "verify:car": "node scripts/car.mjs",
    "verify:boat": "node scripts/boat.mjs",
    "perf": "node scripts/perf.mjs",
    "shoot": "node scripts/shoot.mjs",
    "audit": "node scripts/audit.mjs",
    "qa": "node scripts/qa.mjs",
    "photo-match": "node scripts/photo-match.mjs",
    "verify:tour": "node scripts/tour.mjs",
    "check:flags": "node scripts/check-flags.mjs",
    "check:batcher": "node scripts/check-batcher.mjs",
    "check:commerce": "node scripts/check-commerce-foundation.mjs",
    "deploy:hk": "bash deploy/deploy-hk.sh",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "test": "python3 scripts/test-perf-region.py && node --test scripts/telemetry-test.mjs && npm run test:api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@hono/node-server": "^2.1.11",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "pg": "^8.23.1",
    "three": "0.180.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/three": "0.180.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "4.114.0"
  }
}
