{
  "name": "guilinol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "world": "uv run --locked python pipeline/world.py",
    "credits": "node scripts/photo-credits.mjs",
    "og": "node scripts/og.mjs",
    "dev": "vite web --config web/vite.config.ts",
    "build": "node scripts/photo-credits.mjs && tsc -p web && vite build web --config web/vite.config.ts && node scripts/og.mjs",
    "preview": "vite preview web --config web/vite.config.ts",
    "verify:flight": "node scripts/flight.mjs",
    "verify:atlas": "node --experimental-strip-types scripts/atlas.mjs",
    "verify:walk": "node scripts/walk.mjs",
    "verify:ride": "node scripts/ride.mjs",
    "perf": "node scripts/perf.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
