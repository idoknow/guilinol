{
  "name": "guilinol",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "check:layout": "sh scripts/check-layout.sh",
    "verify:fishing": "node --import tsx --test scripts/test-fishing-grades.mjs scripts/test-fishing-inventory.mjs && node scripts/verify-fishing.mjs",
    "world:dev": "node scripts/world-dev.mjs",
    "refpack": "uv run --locked python pipeline/fetch_city_ref.py",
    "verify:mp": "node scripts/verify-mp.mjs",
    "verify:cloud-save": "tsx scripts/verify-cloud-save.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:admin": "node scripts/auth-test.mjs --admin-ui",
    "test:smoke": "node --import tsx --test scripts/smoke-test.mjs",
    "dev:full": "npm run build && wrangler d1 migrations apply glol --local && wrangler pages dev dist --binding EMAIL_DEV_LOG=1",
    "test:api": "node --test scripts/test-projection.mjs && node scripts/auth-test.mjs",
    "verify:feedback": "node scripts/auth-test.mjs --feedback-ui",
    "verify:entry-session": "node scripts/verify-entry-session.mjs",
    "verify:auth": "node scripts/auth-test.mjs --ui",
    "check:api": "tsc -p functions",
    "basis": "node scripts/basis.mjs",
    "predev": "npm run basis",
    "prebuild": "npm run basis",
    "landmarks": "uv run --locked python pipeline/pack_landmarks.py",
    "world": "uv run --locked python pipeline/world.py",
    "audit:grounding": "uv run --locked python pipeline/audit_grounding.py",
    "audit:seams": "uv run --locked python pipeline/audit_seams.py",
    "audit:landmarks": "uv run --locked python pipeline/audit_landmarks.py",
    "audit:grounding:market": "uv run --locked python scripts/dongxi/grounding.py",
    "credits": "node scripts/photo-credits.mjs",
    "og": "node scripts/og.mjs",
    "dev": "vite web --config web/vite.config.ts",
    "build": "node scripts/photo-credits.mjs && tsc -p web && vite build web --config web/vite.config.ts && node scripts/og.mjs",
    "preview": "vite preview web --config web/vite.config.ts",
    "postbuild": "node scripts/bake-dams.mjs dist/world",
    "verify:flight": "node scripts/flight.mjs",
    "verify:spawn": "node scripts/spawn-pool.mjs --check",
    "verify:atlas": "node --experimental-strip-types scripts/atlas.mjs",
    "verify:walk": "npm run verify:walk:quick",
    "verify:walk:test-ride": "node scripts/verify-test-ride-end.mjs",
    "verify:walk:quick": "node scripts/walk-quick.mjs",
    "verify:road-barriers": "node --experimental-strip-types --test scripts/test-road-barriers-unit.mjs && node scripts/verify-road-barriers.mjs",
    "verify:walk:full": "node scripts/walk.mjs",
    "verify:ride": "node scripts/ride.mjs && node scripts/verify-zone-impact.mjs bike bicycle",
    "verify:ride:stunt": "node scripts/ride-stunt.mjs",
    "verify:ride-audio": "node scripts/ride-audio-levels.mjs",
    "verify:car": "node scripts/car.mjs",
    "verify:drive": "node scripts/drive.mjs && npm run verify:car && node scripts/verify-zone-impact.mjs car",
    "verify:traffic": "node --import tsx --test scripts/test-npc-pose-and-sidewalk.mjs && tsx scripts/test-traffic-wall.ts && node --experimental-strip-types scripts/verify-traffic-recovery.mjs && node --experimental-strip-types scripts/verify-traffic.mjs && node --experimental-strip-types scripts/verify-traffic-popin.mjs && node scripts/traffic-street.mjs",
    "test:npc-pose": "node --import tsx --test scripts/test-npc-pose-and-sidewalk.mjs && uv run --locked python -m unittest pipeline/test_npc_sidewalks.py",
    "verify:npc-pose": "node scripts/verify-npc-scarecrow-sidewalk.mjs",
    "verify:traffic-heights": "uv run python pipeline/verify_traffic_heights.py",
    "verify:boat": "node scripts/boat.mjs",
    "perf": "node scripts/perf.mjs",
    "shoot": "node scripts/shoot.mjs",
    "audit": "node scripts/audit.mjs",
    "qa": "node scripts/qa.mjs",
    "photo-match": "node scripts/photo-match.mjs",
    "verify:tour": "node scripts/tour.mjs",
    "test:missions": "python3 scripts/test-mission-roads.py && tsx scripts/test-missions-economy.ts",
    "verify:missions": "node scripts/verify-missions.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "check:flags": "node scripts/check-flags.mjs",
    "check:batcher": "node scripts/check-batcher.mjs",
    "check:commerce": "node scripts/check-commerce-foundation.mjs",
    "verify:commerce": "node scripts/test-guilin-commerce-loop.mjs",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "test": "python3 scripts/test-perf-region.py && node --test scripts/telemetry-test.mjs scripts/mp-admin-test.mjs && npm run test:api",
    "verify:modes": "node scripts/verify-modes.mjs",
    "verify:qq": "node scripts/verify-qq-entry.mjs",
    "verify:hud": "node scripts/verify-hud-extras.mjs",
    "verify:camera": "node --experimental-strip-types --test scripts/camera-hold-test.mjs && node scripts/verify-camera.mjs",
    "verify:drone": "node scripts/verify-drone.mjs",
    "verify:creator": "tsx scripts/verify-creator.mjs",
    "test:emote": "node --experimental-strip-types --test scripts/emote-test.mjs",
    "test:rt-aoi": "node scripts/rt-aoi-check.mjs",
    "chat:words:import": "node scripts/chat-words-import.mjs",
    "test:chat": "node --test scripts/chat-test.mjs scripts/chat-lexicon-test.mjs scripts/chat-corpus-test.mjs",
    "bench:chat": "node scripts/chat-bench.mjs",
    "bench:rt": "node scripts/rt-load.mjs",
    "audit:station-road-grades": "tsx scripts/audit-station-road-grades.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@hono/node-server": "^2.1.11",
    "chinese-conv": "4.1.0",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "n8ao": "2.1.0",
    "pg": "^8.23.1",
    "postprocessing": "6.39.6",
    "qrcode-generator": "2.0.4",
    "three": "0.180.0",
    "three-good-godrays": "0.12.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/three": "0.180.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "4.114.0"
  }
}
